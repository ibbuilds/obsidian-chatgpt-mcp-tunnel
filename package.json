{
  "name": "obsidian-chatgpt-mcp-tunnel",
  "version": "0.8.0",
  "private": true,
  "description": "Configure and automatically manage a secure MCP tunnel from Obsidian to ChatGPT.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "test:browser": "node tests/browser/run.mjs",
    "smoke:client": "node tests/official-client-smoke.mjs",
    "bundle": "node esbuild.config.mjs production",
    "build": "npm run typecheck && npm run test && npm run bundle"
  },
  "keywords": [
    "obsidian",
    "mcp",
    "tunnel",
    "chatgpt"
  ],
  "author": "ibbuilds",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "22.15.29",
    "esbuild": "0.25.10",
    "obsidian": "1.13.1",
    "typescript": "5.9.3"
  }
}
